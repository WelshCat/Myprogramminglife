<?xml version="1.0" encoding="utf-8"?>
<!--
  버튼의 android:tag 는 동작 이름이다 (MainActivity.Action 참고).
  "repeat:" 로 시작하면 누르고 있는 동안 반복한다.
  연결된 기기(Google TV / 크롬캐스트)가 지원하지 않는 버튼은 자동으로 숨겨진다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="11dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 상단: 상태 / 설정 / 전원 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot"
                android:backgroundTint="@color/muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="크롬캐스트를 선택하세요"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/subText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_press_bg"
                android:contentDescription="기기 선택 및 설정"
                android:src="@drawable/ic_settings"
                android:tint="@color/muted" />

            <ImageButton
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/power_bg"
                android:contentDescription="전원"
                android:src="@drawable/ic_power"
                android:tag="POWER"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <Button style="@style/RemoteButton" android:tag="WAKE" android:text="TV 켜기" />
            <Button style="@style/RemoteButton" android:tag="INPUT" android:text="입력 선택" />
            <Button style="@style/RemoteButton" android:tag="STOP_APP" android:text="캐스트 종료" />
            <Button style="@style/RemoteButton" android:tag="SETTINGS" android:text="설정" />
        </LinearLayout>

        <!-- 지금 재생 중 (크롬캐스트) -->
        <TextView
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/panel_bg"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 방향키 (Google TV) -->
        <FrameLayout
            android:id="@+id/dpad"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:background="@drawable/dpad_bg">

            <ImageButton style="@style/ArrowButton" android:layout_gravity="top|center_horizontal"
                android:contentDescription="위" android:src="@drawable/ic_up" android:tag="repeat:UP" />
            <ImageButton style="@style/ArrowButton" android:layout_gravity="bottom|center_horizontal"
                android:contentDescription="아래" android:src="@drawable/ic_down" android:tag="repeat:DOWN" />
            <ImageButton style="@style/ArrowButton" android:layout_gravity="start|center_vertical"
                android:contentDescription="왼쪽" android:src="@drawable/ic_left" android:tag="repeat:LEFT" />
            <ImageButton style="@style/ArrowButton" android:layout_gravity="end|center_vertical"
                android:contentDescription="오른쪽" android:src="@drawable/ic_right" android:tag="repeat:RIGHT" />

            <Button
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/ok_bg"
                android:stateListAnimator="@null"
                android:tag="OK"
                android:text="확인"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout style="@style/Row">
            <Button style="@style/RemoteButton" android:tag="BACK" android:text="↩ 뒤로" />
            <Button style="@style/RemoteButton" android:tag="HOME" android:text="홈" />
        </LinearLayout>

        <!-- 음량 -->
        <LinearLayout
            style="@style/Row"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <Button style="@style/RemoteButton" android:layout_height="64dp" android:contentDescription="음량 내리기"
                android:tag="repeat:VOL_DOWN" android:text="−" android:textSize="26sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/panel_bg"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="음량" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/volumeText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="–" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
            <Button style="@style/RemoteButton" android:layout_height="64dp" android:contentDescription="음량 올리기"
                android:tag="repeat:VOL_UP" android:text="+" android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <Button style="@style/RemoteButton" android:tag="MUTE" android:text="음소거" />
        </LinearLayout>

        <!-- 재생 제어 -->
        <LinearLayout style="@style/Row" android:layout_marginTop="6dp">
            <Button style="@style/RemoteButton" android:contentDescription="뒤로 감기" android:tag="REWIND" android:text="◀◀" />
            <Button style="@style/RemoteButton" android:contentDescription="재생/일시정지" android:tag="PLAY_PAUSE" android:text="▶ ❚❚" />
            <Button style="@style/RemoteButton" android:contentDescription="정지" android:tag="STOP" android:text="■" />
            <Button style="@style/RemoteButton" android:contentDescription="앞으로 감기" android:tag="FORWARD" android:text="▶▶" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
